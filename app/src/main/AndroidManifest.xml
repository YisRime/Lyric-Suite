<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.MEDIA_CONTENT_CONTROL"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name="de.yisrime.lrcbar.LyricApplication"
        android:description="@string/xposed_tips"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StatusbarLyric"
        tools:targetApi="s">
        <activity
            android:name="de.yisrime.lrcget.ui.activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="de.yisrime.lyricsuite.LauncherAlias"
            android:exported="true"
            android:targetActivity="de.yisrime.lrcget.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name="de.yisrime.lrcget.ui.activity.TestActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="de.yisrime.lrcget.ui.activity.LogActivity"
            android:exported="false"
            android:label="@string/log_page"
            android:theme="@style/Theme.MyApplication" />
        <activity
            android:name="de.yisrime.lrcget.ui.activity.DialogTransparentActivity"
            android:exported="true"
            android:theme="@style/Theme.DialogTransparentActivityTheme"
            android:windowSoftInputMode="adjustResize|stateHidden" />
    </application>
</manifest>
